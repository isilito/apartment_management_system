# Everything not listed here is uploaded, and anything that is not a PHP
# function is served as a public static file — so keep private files out.

# SQL dumps contain the demo password hashes; import them into the database instead
database/

# local-only (XAMPP) upload folder and Apache rules; Vercel stores uploads in the database
api/uploads/

# Hobby plan allows 12 functions and every api/*.php is one. photos.php only
# works where it can read the folders (XAMPP); on Vercel the browser checks
# for assets/img/units/<unit>/1.jpg, 2.jpg … itself (assets/js/unit-photos.js)
api/photos.php
.htaccess
**/.htaccess

# project documents and repo config, not part of the site
docs/
README.md
*.pdf
/*.png
.gitattributes
.gitignore
.env*

# local secrets and templates (Vercel uses environment variables)
api/config.local.php
api/config.local.example.php
