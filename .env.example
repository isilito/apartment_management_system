# Environment variables for the Vercel deployment.
# Add these under Vercel → Project → Settings → Environment Variables.
# XAMPP does not read this file; edit api/config.php there instead.
# See docs/DATABASE_SETUP.md for where each value comes from.

SARAZA_DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
SARAZA_DB_PORT=4000
SARAZA_DB_NAME=saraza_apartment
SARAZA_DB_USER=xxxxxxxxxxxx.root
SARAZA_DB_PASS=change-me
SARAZA_DB_SSL=1

# Only for providers with their own certificate authority (e.g. Aiven):
# paste the whole CA certificate, including the BEGIN/END lines.
# SARAZA_DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# Optional overrides (the defaults are right for Vercel):
# SARAZA_SESSION_STORE=db
# SARAZA_UPLOAD_STORE=db
# SARAZA_MAX_UPLOAD_MB=4
# SARAZA_MAX_REQUEST_MB=4.4

# AI assistant (Google Gemini). Leave empty to use the built-in answers.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
